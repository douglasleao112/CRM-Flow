{
  "manifest_version": 3,
  "name": "WhatsApp Flow Builder v2.3",
  "version": "2.16.39",
  "description": "Editor visual e engine de automações para WhatsApp Web, com suporte a fluxos grandes e mídias em Base64.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://unpkg.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Flow Builder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "editor.html",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "audio-converter.js",
        "content.js",
        "whatsapp-kanban.js",
        "trigger-matcher.js",
        "engine.js"
      ],
      "css": [
        "chat-control.css",
        "whatsapp-kanban.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "page-bridge.js",
        "vendor-loader.js",
        "wppconnect-wa.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:;"
  }
}
